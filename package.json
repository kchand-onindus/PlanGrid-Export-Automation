{
  "name": "plangrid-export-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "export": "HEADLESS=false tsx src/main.ts",
    "export:chrome": "HEADLESS=false tsx src/main.ts --connect-chrome",
    "headless": "HEADLESS=true tsx src/main.ts",
    "import:prepare": "tsx src/import/main.ts",
    "kahua": "tsx src/kahua/main.ts",
    "test:import": "tsx --test src/import/preparation.test.ts",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
