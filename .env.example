# Copy this file to .env and fill in your local credentials.
PLANGRID_EMAIL=
PLANGRID_PASSWORD=
PLATFORM_URL=https://app.plangrid.com
DOWNLOAD_DIR=downloads
# Local Documents/Photos staging directory. Relative paths resolve from this repository.
SYNC_UP_DIR=sync_ups
# Local staging for everything except Documents/Photos. Relative paths resolve from this repository.
DRAWINGS_DIR=drawings

# Export batching: skip counts only enabled projects; blank limit means all remaining.
# Command-line --skip/--offset and --limit override these. Retry mode ignores both.
BATCH_SKIP=0
BATCH_LIMIT=

# Kahua import browser workflow (separate credentials from PlanGrid).
KAHUA_URL=https://devproductionlaunch.kahua.com/
KAHUA_USERNAME=
KAHUA_PASSWORD=
